generator client {
  provider   = "prisma-client-js"
  // "client" engine = no native Rust binary; queries go through @prisma/adapter-pg.
  // Wasmer Edge cannot load native .node addons, so this is required there.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  // Supabase transaction pooler (port 6543) - used by the running app.
  url       = env("DATABASE_URL")
  // Supabase direct / session connection (port 5432) - used by `prisma db push`.
  directUrl = env("DIRECT_URL")
}

model Reader {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         String
  createdAt    DateTime     @default(now())
  downloads    Download[]
  bookmarks    Bookmark[]
  shelf        ShelfEntry[]
}

model Title {
  id          String       @id @default(cuid())
  slug        String       @unique
  work        String
  writer      String
  category    String
  year        Int
  note        String
  gutenbergId Int?
  workKey     String
  writerKey   String
  categoryKey String
  createdAt   DateTime     @default(now())
  downloads   Download[]
  bookmarks   Bookmark[]
  shelf       ShelfEntry[]
}

model Download {
  id        String   @id @default(cuid())
  titleId   String
  readerId  String?
  guestIp   String?
  createdAt DateTime @default(now())
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  reader    Reader?  @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@index([readerId, titleId])
  @@index([guestIp, titleId])
}

model Bookmark {
  id        String   @id @default(cuid())
  readerId  String
  titleId   String
  createdAt DateTime @default(now())
  reader    Reader   @relation(fields: [readerId], references: [id], onDelete: Cascade)
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([readerId, titleId])
}

model ShelfEntry {
  id        String   @id @default(cuid())
  readerId  String
  titleId   String
  createdAt DateTime @default(now())
  reader    Reader   @relation(fields: [readerId], references: [id], onDelete: Cascade)
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([readerId, titleId])
}
