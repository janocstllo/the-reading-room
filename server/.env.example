# Copy this file to server/.env and fill in your Supabase values.
# Supabase dashboard -> your project -> Connect -> "ORMs" / "Connection string".

# Transaction pooler (port 6543). Used by the running app.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Session pooler or direct connection (port 5432). Used by `npm run db:push`.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me"

# Staff (desk) account created at startup. Password must be 12+ characters.
DESK_EMAIL="you@example.com"
DESK_PASSWORD="choose-a-strong-password"
DESK_NAME="Your Name"

# Local development only: also create the demo accounts
# reader@readingroom.local / Reader123!  and  desk@readingroom.local / Desk123!
# Never set this to true on the public site.
SEED_DEMO_ACCOUNTS=false

# Set to true on Wasmer so guest download limits use the real visitor IP.
TRUST_PROXY=false
